# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=

# GEMINI_MODEL: Model to use for Gemini API calls. Default: gemini-3.8-flash
GEMINI_MODEL="gemini-3.8-flash"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Default admin seed credentials (used on initial seed if no admin exists)
ADMIN_USERNAME=admin321
ADMIN_PASSWORD=pass

# Session & JWT secret (generate a secure random secret in production)
SESSION_SECRET=lavosia_jwt_session_secret_change_in_production

